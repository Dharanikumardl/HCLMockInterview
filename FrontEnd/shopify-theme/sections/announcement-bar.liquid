{% if section.settings.show_announcement %}
  <div class="announcement">
    {{ section.settings.text }}
  </div>
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Gentle care for kids aged 5-12 🌿"
    }
  ]
}
{% endschema %}
