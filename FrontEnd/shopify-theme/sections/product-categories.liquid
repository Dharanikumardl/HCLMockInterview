<section class="container">
  <h2>{{ section.settings.title }}</h2>
  <div class="category-grid">
    {% for block in section.blocks %}
      <article class="category-card" {{ block.shopify_attributes }}>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.description }}</p>
        {% if block.settings.link != blank %}
          <a class="button" href="{{ block.settings.link }}">Explore</a>
        {% endif %}
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Product categories",
  "settings": [
    { "type": "text", "id": "title", "label": "Section title", "default": "Daily Essentials for Growing Kids" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Kids Body Wash" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Mild cleansing for active days." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Product categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Kids Body Wash", "description": "Gentle cleansing with skin-friendly formula." } },
        { "type": "category", "settings": { "title": "Nourishing Cream", "description": "Hydration that keeps skin soft all day." } },
        { "type": "category", "settings": { "title": "Soft Shampoo", "description": "Tear-aware, scalp-friendly daily shampoo." } },
        { "type": "category", "settings": { "title": "Care Oil", "description": "Light, non-sticky nourishment for skin and hair." } }
      ]
    }
  ]
}
{% endschema %}
